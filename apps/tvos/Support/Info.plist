<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The logo on the canvas colour; the app's launch view draws the
	     same, so start-up reads as one screen. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIImageName</key>
		<string>Logo</string>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<!-- Xtream panels serve their API, artwork and streams over plain HTTP,
	     on hosts the user types in. There is no fixed list to allow. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
